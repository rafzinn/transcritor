# Copie para .env e preencha. O .env NAO vai para o repositorio.
TG_CHAT_ID=000000000          # id do chat que pode usar o bot (/id mostra o seu)
APP_DIR=/opt/transcritor      # onde o projeto vive no host (bind mounts)

# Nomes dos docker secrets. Deixe assim se criou com os nomes padrao.
SECRET_TG_TOKEN=tg_bot_token
SECRET_OPENAI=openai_api_key
SECRET_TG_API_ID=tg_api_id
SECRET_TG_API_HASH=tg_api_hash

# ── Pagina web de upload (opcional; sem UPLOAD_HOST o deploy.sh nao a sobe) ──
# UPLOAD_HOST=upload.exemplo.com            # hostname que o proxy vai atender
# WEB_NETWORK=web                            # rede overlay externa onde o Traefik esta
# UPLOAD_CERTRESOLVER=letsencryptresolver    # resolver TLS do seu Traefik
# UPLOAD_MIDDLEWARES=tailnet-only            # middleware que FECHA a pagina (obrigatorio)
# UPLOAD_PRIORITY=100                        # prioridade do roteador
# UPLOAD_MAX_MB=4000                         # teto por arquivo
