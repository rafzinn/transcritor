# Copie para .env e preencha. O .env NAO vai para o repositorio.
TG_CHAT_ID=000000000          # id do chat que pode usar o bot (/id mostra o seu)
DOCKER_NET=web                # rede overlay externa ja existente no Swarm
APP_DIR=/opt/transcritor      # onde o projeto vive no host (bind mounts)

# Nomes dos docker secrets. Deixe assim se criou com os nomes padrao.
SECRET_TG_TOKEN=tg_bot_token
SECRET_OPENAI=openai_api_key
SECRET_TG_API_ID=tg_api_id
SECRET_TG_API_HASH=tg_api_hash
